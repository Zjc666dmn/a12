ANTHROPIC_AUTH_TOKEN=your_deepseek_or_anthropic_compatible_key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
MODEL_CONFIG_THEME=light
ACTIVE_MODEL_PROVIDER=DeepSeek
ACTIVE_MODEL_ID=deepseek
ACTIVE_MODEL_ENDPOINT=https://api.deepseek.com/anthropic
ACTIVE_MODEL_NAME=deepseek-v4-pro

# 后端访问令牌：设置为随机字符串后，所有 /api 请求（除 /api/health）都需要
# Authorization: Bearer <此令牌>。留空则关闭鉴权（仅限本地开发）。
TEACHNOVA_API_TOKEN=

# 允许的跨域来源（逗号分隔），默认本地开发端口
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_ALLOW_DOWNLOAD=true
EMBEDDING_FALLBACK_PROVIDER=hash
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
